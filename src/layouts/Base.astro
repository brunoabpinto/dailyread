---
interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const { title, description = 'One exceptional free article, every day.', current } = Astro.props;
import topics from '../topics.json';

const nav = [
  { key: 'all', label: 'All', href: '/' },
  ...topics.map((t) => ({ key: t.key, label: t.label, href: `/${t.key}/` })),
];

// Per-topic colors (light + dark) and the classes that use them, generated from topics.json.
const vars = (mode: 'light' | 'dark') => topics.map((t) => `--${t.key}: ${t[mode]};`).join(' ');
const topicCss = `
  :root { ${vars('light')} }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) { ${vars('dark')} } }
  :root[data-theme='dark'] { ${vars('dark')} }
  ${topics.map((t) => `.topic.${t.key} { color: var(--${t.key}); } .placeholder.${t.key} { background: var(--${t.key}); }`).join('\n  ')}
`;
const pageTitle = title ? `${title} · Daily Read` : 'Daily Read';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style is:inline set:html={topicCss}></style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site">
      <a href="/" class="brand">
        <img class="logo-light" src="/logo-light.png" alt="Daily Read" width="816" height="187" />
        <img class="logo-dark" src="/logo-dark.png" alt="Daily Read" width="816" height="187" />
      </a>
      <button id="theme-toggle" type="button" aria-label="Toggle light/dark theme">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" />
        </svg>
      </button>
      <nav class="topics">
        {nav.map((n) => (
          <a href={n.href} aria-current={n.key === current ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">{topics.map((t) => t.label).join(' · ')}</footer>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf8f4;
    --text: #1d1b18;
    --muted: #6b665e;
    --line: #e4dfd6;
    --accent: #2f5d3a;
    --serif: 'Newsreader', Georgia, serif;
    --sans: 'Inter', system-ui, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #151412;
      --text: #ece8e1;
      --muted: #9b958b;
      --line: #2c2a26;
      --accent: #8cc49a;
    }
  }
  :root[data-theme='dark'] {
    --bg: #151412;
    --text: #ece8e1;
    --muted: #9b958b;
    --line: #2c2a26;
    --accent: #8cc49a;
  }
  #theme-toggle {
    margin-left: auto;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    width: 48px;
    height: 48px;
    color: var(--text);
    display: grid;
    place-items: center;
    padding: 0;
    cursor: pointer;
  }
  #theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  * { box-sizing: border-box; }
  /* Scale all rem sizes so body text (1.125rem) is 20px. */
  html { font-size: calc(100% * 20 / 18); }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--serif);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  main, header.site, footer.site {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 16px;
  }
  header.site {
    padding-top: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }
  .brand { display: inline-flex; align-self: center; }
  /* Wordmark image; light/dark versions follow the theme. */
  .brand img { display: block; height: 2.08rem; width: auto; }
  .logo-dark { display: none !important; }
  :root[data-theme='dark'] .logo-light { display: none !important; }
  :root[data-theme='dark'] .logo-dark { display: block !important; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .logo-light { display: none !important; }
    :root:not([data-theme='light']) .logo-dark { display: block !important; }
  }
  nav.topics {
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 0.85rem;
  }
  nav.topics a { color: var(--muted); text-decoration: none; }
  nav.topics a:hover { color: var(--accent); }
  nav.topics a[aria-current='page'] { color: var(--text); font-weight: 500; text-decoration: underline; text-underline-offset: 4px; }
  footer.site {
    margin-top: 4rem;
    padding-top: 1.5rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--line);
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }
  a { color: var(--accent); }
  .meta {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
  }
  .topic {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }
  a.topic { text-decoration: none; }
  a.topic:hover { text-decoration: underline; }
</style>
